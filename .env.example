# .env로 복사해서 값을 채운다. .env는 커밋하지 않는다.

# 외부 공개 포트 (호스트) -> 컨테이너 25565
MC_PORT=

# 마인크래프트 버전. 첫 기동은 LATEST, 기동 로그에서 확인한 버전(예: 1.21.4)으로 고정
MC_VERSION=LATEST

# DuckDNS (scripts/duckdns-update.sh). 서브도메인만 적는다 (예: myserver)
DUCKDNS_DOMAIN=
# DuckDNS 토큰. 노출되면 duckdns.org에서 재발급
DUCKDNS_TOKEN=

# 월드 백업 (scripts/world-backup.sh). 남길 백업 개수, 비우면 7
BACKUP_KEEP=7

# RCON 비밀번호. mc와 관리 API가 함께 쓴다. 예: openssl rand -hex 24
# 바꾸면 mc 컨테이너를 다시 만들어야 한다 (docker compose up -d)
RCON_PASSWORD=

# 관리 API (api/). 외부에 공개하지 않는다
# 호스트 포트 (127.0.0.1과 Tailscale IP에 바인딩)
API_PORT=
# 이 호스트의 Tailscale IP (tailscale ip -4)
API_TAILSCALE_IP=
# Bearer 토큰. 예: openssl rand -hex 32. 노출되면 바꾸고 docker compose up -d api
API_TOKEN=
